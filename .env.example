ODOO_URL=https://TU-INSTANCIA.odoo.com
ODOO_DB=TU_BASE
ODOO_USER=TU_USUARIO
ODOO_API_KEY=TU_API_KEY
DASHBOARD_ROTACION_DIR=.
DASHBOARD_HOST=127.0.0.1
PORT=5001
